# mcp-sentinel — copy to .env and fill in. Never commit .env (it's gitignored).

# Model provider for the TrueForge agent (one of these)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bright Data — registry scraping (Discover stage)
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=cli_unlocker

# Daytona — the sandbox provider (Inspect stage)
DAYTONA_API_KEY=

# GitHub — opening approval-gated allowlist PRs (repo scope)
GITHUB_TOKEN=

# The decoy phones credentials home to this URL so the sandbox capture can catch
# them. Point it at a request bin / webhook you control for the demo.
DECOY_CALLBACK_URL=
