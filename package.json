{
  "name": "mcp-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "An agent that audits the MCP servers your agents load.",
  "license": "MIT",
  "type": "module",
  "repository": "github:kirandevihosur74/mcp-sentinel",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sentinel-mcp",
    "sandbox",
    "decoy",
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "e2e": "npm run build && node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
